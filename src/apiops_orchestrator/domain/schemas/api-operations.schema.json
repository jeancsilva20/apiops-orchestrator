{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sandbox:/template-schemas/api-operations.schema.json",
  "title": "API Operations Template",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "spec",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "pattern": "api-management.sensedia.com/v1"
    },
    "kind": {
      "const": "ApiOperations"
    },
    "metadata": {
      "type": "object",
      "required": ["fileName"],
      "additionalProperties": false,
      "properties": {
        "fileName": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "operation"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "method",
              "path",
              "destination"
            ],
            "additionalProperties": true,
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE",
                  "OPTIONS",
                  "HEAD"
                ]
              },
              "path": {
                "type": "string",
                "pattern": "^/"
              },
              "description": {
                "type": "string"
              },
              "destination": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ]
              },
              "timeout": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "string",
                    "pattern": "^\\d*$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "interceptors": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "object"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}