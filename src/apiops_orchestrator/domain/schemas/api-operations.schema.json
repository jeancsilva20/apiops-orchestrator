{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApiOperations Schema",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "spec",
    "metadata"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "api-management.sensedia.com/v1"
    },
    "kind": {
      "type": "string",
      "const": "ApiOperations"
    },
    "metadata": {
      "type": "object",
      "required": [
        "fileName"
      ],
      "additionalProperties": false,
      "properties": {
        "fileName": {
          "type": "string"
        }
      }
    },
    "spec": {
      "type": "object",
      "required": [
        "operation"
      ],
      "additionalProperties": false,
      "properties": {
        "operation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "method",
              "path",
              "destination"
            ],
            "additionalProperties": false,
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE",
                  "OPTIONS",
                  "HEAD"
                ]
              },
              "path": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "destination": {
                "type": "string"
              },
              "timeout": {
                "type": [
                  "string",
                  "integer",
                  "null"
                ]
              },
              "interceptors": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "position",
                    "type",
                    "content",
                    "executionPoint",
                    "status"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "position": {
                      "type": [
                        "integer",
                        "string"
                      ]
                    },
                    "type": {
                      "type": "string"
                    },
                    "content": {
                      "anyOf": [
                        {
                          "type": "object"
                        },
                        {
                          "type": "string"
                        },
                        {
                          "type": "integer"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "executionPoint": {
                      "type": "string",
                      "enum": [
                        "FIRST",
                        "SECOND"
                      ]
                    },
                    "status": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
