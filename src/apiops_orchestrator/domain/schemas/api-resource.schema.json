{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "api-resource.schema.json",
  "title": "Recurso (resources/<slug>/resource.yaml)",
  "description": "Arquivo plano, sem involucro apiVersion/kind. Layout canonico da D-005 3/4; interceptors pela V-26 (inherit) e V-25 (tombstone).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Nome do recurso no Manager. NAO precisa casar com o nome da pasta (D-005 3)."
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "destination": {
      "$ref": "#/$defs/destination"
    },
    "inherit": {
      "type": "boolean",
      "description": "true = os itens declarados executam depois do fluxo herdado; sem itens, o escopo so herda. false = executa exatamente o fluxo declarado; sem itens, o escopo nao executa nenhum interceptor."
    },
    "interceptors_request": {
      "$ref": "#/$defs/fluxo",
      "description": "Mapeia para o execution point FIRST. A ordem da lista e a fonte declarativa."
    },
    "interceptors_response": {
      "$ref": "#/$defs/fluxo",
      "description": "Mapeia para o execution point SECOND. A ordem da lista e a fonte declarativa."
    }
  },
  "$defs": {
    "destination": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": [
            "string",
            "null"
          ],
          "description": "String vazia significa herdar do escopo acima (V-03). Aceita variavel de ambiente ($var)."
        },
        "timeout": {
          "type": [
            "string",
            "integer",
            "null"
          ],
          "description": "Em segundos, teto de 60s do gateway. O wire devolve como STRING: preservar as aspas."
        }
      }
    },
    "fluxo": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interceptor"
      }
    },
    "interceptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "integer",
          "description": "Somente para type: Custom."
        },
        "content": {
          "description": "Somente para tipos nativos.",
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "Custom"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "id"
            ],
            "not": {
              "required": [
                "content"
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "id"
              ]
            }
          }
        }
      ]
    }
  }
}
