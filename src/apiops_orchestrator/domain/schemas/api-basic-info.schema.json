{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ApiBasicInfo Schema",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "api-management.sensedia.com/v1"
    },
    "kind": {
      "type": "string",
      "const": "ApiBasicInfo"
    },
    "spec": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "basePath"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "basePath": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "creationDate": {
          "type": "string"
        },
        "lastUpdate": {
          "type": "string"
        },
        "apiResponsible": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "username": {
              "type": "string"
            },
            "groupName": {
              "type": "string"
            }
          }
        },
        "visibility": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "groupVisibility": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
