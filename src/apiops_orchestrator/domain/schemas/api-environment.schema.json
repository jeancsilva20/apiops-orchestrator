{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Environment Schema",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "spec"
  ],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "api-management.sensedia.com/v1"
    },
    "kind": {
      "type": "string",
      "const": "Environment"
    },
    "spec": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "envID",
          "revDepl"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "envID": {
            "type": "integer"
          },
          "revDepl": {
            "type": "integer"
          },
          "description": {
            "type": "string"
          },
          "vars": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string"
                },
                "value": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                },
                "variableType": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
