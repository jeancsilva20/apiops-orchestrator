# Configurações do Manager
HOST="https://api.example.com"
AUTHORIZATION="Basic <<your_base64_encoded_credentials>>"
OAUTH_CLIENT_ID="username"
OAUTH_CLIENT_SECRET="secret"
REQUEST_TIMEOUT=30

# Dados da API
API_ID=666

# Autenticação da CLI (sen login)
AUTH_HOST="https://api.example.com"
AUTH_LOGIN_PATH="/cli-2/orq-auth/v1/oauth2/token"

# Rota de validação do accessToken (opcional)
# Default derivado: {AUTH_LOGIN_PATH}/validation — defina apenas para override total
# AUTH_VALIDATE_PATH="/oauth2/token/validation"

# =============================================================================
# Modo de execução e alvos  (V-11 binding · V-24 · D-12)
# =============================================================================

# local    → CLI na máquina do dev. A régua vem de `spec.template` no manifesto,
#            e a publicação na Draft exige confirmação interativa (guarda 2).
# pipeline → esteira. A régua vem de TEMPLATE_API_ID, injetado pelo cofre, e não
#            há confirmação. Ausente assume `local`.
EXECUTION_MODE=local

# Id da API-régua (Golden Path). SÓ é lido quando EXECUTION_MODE=pipeline — em
# `local` a régua vem do manifesto. Na esteira, injete pelo cofre, nunca pelo
# arquivo: é o que impede alterar a régua por um commit.
#
#   env:
#     EXECUTION_MODE: pipeline
#     TEMPLATE_API_ID: ${{ secrets.APIOPS_TEMPLATE_API_ID }}
#
# Em `pipeline` SEM este valor a operação falha por configuração (exit 1):
# validar contra nada numa esteira é pior do que parar.
# TEMPLATE_API_ID=414

# Revisão alvo do publish, pelo NÚMERO que aparece na UI — nunca pelo id.
# 1=Draft · 2=DEV · 3=HML · 4=PRD. Em modo `local` o único valor aceito é 1:
# a Draft não é ambiente, não tem deploy, e publicar nela é diagnóstico.
TARGET_REVISION_NUMBER=1

# =============================================================================
# LEGADO — não usar em código novo
# =============================================================================

# DEPRECADAS pela D-020 (2026-10-15): o stage do Adaptive Governance é
# propriedade da REVISÃO, pré-configurada na plataforma. O orquestrador lê
# `workflowId`/`workflowStageId` do GET da revisão alvo e os reenvia intactos.
# Consumidas apenas pelo pipeline legado (ConversorService).
WORKFLOW_ID=333
WORKFLOW_STAGE_ID=999

# DEPRECADAS (fila de templates/schemas, item 10): os `apiTags` são declarativos
# e vêm do `api-basic-info.yaml`. É sobre eles que o Adaptive Governance calcula
# o atributo faltante, então lê-los do ambiente tiraria governança do
# versionamento. Seguem o padrão: API_TAGS_<descrição>=AttributeName:tag1,tag2
API_TAGS_CUSTOMER=Customer:internal,external
API_TAGS_ORDER=Order:read,write

KIND_VERSION=api-management.sensedia.com/v1
