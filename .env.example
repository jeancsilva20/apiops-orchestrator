# Configurações do Manager
HOST="https://api.example.com"
AUTHORIZATION="Basic <<your_base64_encoded_credentials>>"
OAUTH_CLIENT_ID="username"
OAUTH_CLIENT_SECRET="secret"
REQUEST_TIMEOUT=30

# Dados da API
API_ID=666

# Dados do Adaptive Governance
WORKFLOW_ID=333
WORKFLOW_STAGE_ID=999

# TAGS DA API
# Seguem o seguinte padrão: API_TAGS_<descrição>=AtrributeName:tag1,tag2
API_TAGS_CUSTOMER=Customer:internal,external
API_TAGS_ORDER=Order:read,write

KIND_VERSION=api-management.sensedia.com/v1

# AUTH DA CLI (sen login)
# Credencial única do `sen login`: APENAS o blob Base64(client_id:secret), sem o prefixo "Basic".
# Geração: printf '%s:%s' "${OAUTH_CLIENT_ID}" "${OAUTH_CLIENT_SECRET}" | base64
#SEN_CREDENTIALS=""
# Host dedicado da API de autenticação (sem fallback para HOST). Ex.: https://api-consulting.sensedia.com
AUTH_HOST="https://api-consulting.sensedia.com"
# Path da rota de login da Orchestrator Auth API (sem default em código).
AUTH_LOGIN_PATH="/cli-2/orq-auth/v1/oauth2/token"